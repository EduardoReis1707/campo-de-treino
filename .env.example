# Modelo das variáveis de ambiente. Copie para .env e preencha:
#
#   cp .env.example .env
#
# .env não é versionado. Nunca coloque segredo neste arquivo de exemplo.

# Endereço público do site, sem barra no fim. Usado por sitemap.xml e
# robots.txt. Em desenvolvimento pode ficar em branco: o padrão é
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Pasta do acervo bruto de onde `npm run acervo` lê o Catalogo_e_fontes.json
# e copia os PDFs do lote conferido. Fica fora do repositório. Se ficar em
# branco, o script usa o caminho padrão definido em scripts/gerar-acervo.mjs.
ACERVO_ORIGEM=

# --- Marco 2: administração e curadoria (ainda não usados) ---
# Ao aplicar supabase/migrations/0001_esquema_acervo.sql, preencha:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # segredo de servidor: nunca prefixe com NEXT_PUBLIC_
